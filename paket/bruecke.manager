[ConnectionManager]
BusName=org.freedesktop.Telepathy.ConnectionManager.bruecke
ObjectPath=/org/freedesktop/Telepathy/ConnectionManager/bruecke

[Protocol whatsapp]
param-account=s required
ConnectionInterfaces=org.freedesktop.Telepathy.Connection.Interface.Requests;org.freedesktop.Telepathy.Connection.Interface.SimplePresence;org.freedesktop.Telepathy.Connection.Interface.Contacts;
RequestableChannelClasses=org.freedesktop.Telepathy.Channel.Type.Text
VCardField=x-whatsapp
EnglishName=WhatsApp
Icon=icon-m-service-whatsapp

[Protocol signal]
param-account=s required
ConnectionInterfaces=org.freedesktop.Telepathy.Connection.Interface.Requests;org.freedesktop.Telepathy.Connection.Interface.SimplePresence;org.freedesktop.Telepathy.Connection.Interface.Contacts;
RequestableChannelClasses=org.freedesktop.Telepathy.Channel.Type.Text
VCardField=x-signal
EnglishName=Signal
Icon=icon-m-service-signal

[Protocol telegram]
param-account=s required
ConnectionInterfaces=org.freedesktop.Telepathy.Connection.Interface.Requests;org.freedesktop.Telepathy.Connection.Interface.SimplePresence;org.freedesktop.Telepathy.Connection.Interface.Contacts;
RequestableChannelClasses=org.freedesktop.Telepathy.Channel.Type.Text
VCardField=x-telegram
EnglishName=Telegram
Icon=icon-m-service-telegram

[Protocol matrix]
param-account=s required
ConnectionInterfaces=org.freedesktop.Telepathy.Connection.Interface.Requests;org.freedesktop.Telepathy.Connection.Interface.SimplePresence;org.freedesktop.Telepathy.Connection.Interface.Contacts;
RequestableChannelClasses=org.freedesktop.Telepathy.Channel.Type.Text
VCardField=x-matrix
EnglishName=Matrix
Icon=icon-m-service-matrix

[Protocol briar]
param-account=s required
ConnectionInterfaces=org.freedesktop.Telepathy.Connection.Interface.Requests;org.freedesktop.Telepathy.Connection.Interface.SimplePresence;org.freedesktop.Telepathy.Connection.Interface.Contacts;
RequestableChannelClasses=org.freedesktop.Telepathy.Channel.Type.Text
VCardField=x-briar
EnglishName=Briar
Icon=icon-m-service-briar
